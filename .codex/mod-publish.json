{
  "schemaVersion": 1,
  "workflow": {
    "skill": "publish-mod-update",
    "revision": 5
  },
  "modName": "Sophisticated VH Compat",
  "releaseLedger": "docs/release-ledger.json",
  "version": {
    "sourceFiles": ["gradle.properties"],
    "property": "mod_version",
    "tagPrefix": "v"
  },
  "build": {
    "testCommand": ".\\gradlew.bat test",
    "releaseToolTestCommand": "python -m unittest discover -s scripts/tests -v",
    "buildCommand": ".\\gradlew.bat clean test jarJar",
    "artifactGlob": "build/libs/*-all.jar",
    "excludeGlobs": ["*-sources.jar", "*-dev.jar", "*-shadow.jar"]
  },
  "releaseKit": {
    "template": "docs/release-kit-template.md",
    "assembleCommand": "python scripts/assemble_release_kit.py",
    "outputDirectory": "build/release-kit"
  },
  "github": {
    "repository": "HoYin1600p/SophisticatedVHCompat",
    "defaultBranch": "main",
    "usesAutomaticUpdateCheck": false
  },
  "curseforge": {
    "projectId": "1599839",
    "projectSlug": "sophisticated-vh-compat",
    "publicPage": "https://www.curseforge.com/minecraft/mc-addons/sophisticated-vh-compat",
    "uploadCommand": "python scripts/curseforge_publish.py upload",
    "uploadDryRunCommand": "python scripts/curseforge_publish.py dry-run --rehearsal",
    "catalogValidationCommand": ".\\scripts\\validate_curseforge_game_versions.ps1",
    "gameVersionIds": ["9008", "9016", "7498", "8326", "9638", "9639"],
    "requiredGameVersionTypes": [
      {"name": "Minecraft", "id": "1"},
      {"name": "Minecraft 1.18", "id": "73250"},
      {"name": "Modloader", "id": "68441"},
      {"name": "Java", "id": "2"},
      {"name": "Environment", "id": "75208"}
    ],
    "descriptionFile": "docs/curseforge-description.md",
    "descriptionFormat": "markdown",
    "displayNameTemplate": "Sophisticated VH Compat {version}",
    "releaseChannel": "release",
    "approvalPollMinutes": 15,
    "manualRelease": false,
    "relations": [
      {"slug": "sophisticated-core", "projectId": "618298", "type": "optionalDependency"},
      {"slug": "sophisticated-storage", "projectId": "619320", "type": "optionalDependency"},
      {"slug": "vault-hunters-official-mod", "projectId": "458203", "type": "optionalDependency"}
    ],
    "projectClassGuard": {
      "expectedPathSegment": "mc-mods",
      "observedPathSegment": "mc-addons",
      "allowUpload": false
    }
  },
  "compatibility": {
    "gameVersionSources": ["gradle.properties"],
    "loaderSources": ["src/main/resources/META-INF/mods.toml"],
    "minecraft": "1.18.2",
    "loader": "Forge",
    "java": "17",
    "environment": ["Client", "Server"]
  },
  "identity": {
    "scanCommand": "python scripts/verify_public_identity.py",
    "scanLog": "identity-scan/identity-scan-log.md",
    "workspaceResolution": "CODEX_SHADOW_WORKSPACE override, otherwise sibling Codex Workspaces marker"
  }
}
